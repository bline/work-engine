{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-engine.claim-evidence.core.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_boundary", "authorities", "claims", "revisions", "lineage", "reliances", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "projection_boundary": {"$ref": "#/$defs/projection_boundary"},
    "authorities": {"type": "array", "items": {"$ref": "authority-manifest-v1.schema.json"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "revisions": {"type": "array", "items": {"$ref": "#/$defs/revision"}},
    "lineage": {"type": "array", "items": {"$ref": "#/$defs/lineage"}},
    "reliances": {"type": "array", "items": {"$ref": "#/$defs/reliance"}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation_receipt"}}
  },
  "$defs": {
    "exact_reference": {"type": "object", "additionalProperties": false, "required": ["owner", "reference", "revision", "integrity_sha256", "freshness", "status"], "properties": {"owner": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "freshness": {"type": "string", "minLength": 1}, "status": {"enum": ["verified", "unavailable", "moved_resolvable", "excluded", "integrity_mismatch"]}}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["namespace", "subject_kind", "stable_subject_id", "evidence_baseline", "content_set"], "properties": {"namespace": {"type": "string", "minLength": 1}, "subject_kind": {"type": "string", "minLength": 1}, "stable_subject_id": {"type": "string", "minLength": 1}, "evidence_baseline": {"$ref": "#/$defs/exact_reference"}, "content_set": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "schema_version", "profile", "subject", "statement_identity", "created_by", "authority_ref"], "properties": {"id": {"type": "string"}, "schema_version": {"const": 1}, "profile": {"enum": ["proposal-research-v1", "revision-bound-review-finding-v1"]}, "subject": {"$ref": "#/$defs/subject"}, "statement_identity": {"type": "string", "minLength": 1}, "created_by": {"type": "string", "minLength": 1}, "authority_ref": {"type": "string", "minLength": 1}}},
    "revision": {"type": "object", "additionalProperties": false, "required": ["id", "schema_version", "claim_id", "predecessor_revision", "proposition", "support_qualification", "assumptions", "limitations", "confidence", "evidence_references", "sensitivity_references", "producer", "evidence_mode", "judgment_kind", "decision_scope", "profile_payload", "authority_ref", "reopening_conditions", "tombstone"], "properties": {"id": {"type": "string"}, "schema_version": {"const": 1}, "claim_id": {"type": "string"}, "predecessor_revision": {"type": ["string", "null"]}, "proposition": {"type": "string"}, "support_qualification": {"type": "string"}, "assumptions": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}, "confidence": {}, "evidence_references": {"type": "array", "items": {"$ref": "#/$defs/exact_reference"}}, "sensitivity_references": {"type": "array", "items": {"$ref": "#/$defs/exact_reference"}}, "producer": {"type": "string"}, "evidence_mode": {"type": "string"}, "judgment_kind": {"type": "string"}, "decision_scope": {"type": "string"}, "profile_payload": {"type": "object"}, "authority_ref": {"type": "string"}, "reopening_conditions": {"type": "array", "items": {"type": "string"}}, "tombstone": {"type": "boolean"}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["id", "schema_version", "relationship", "sources", "target", "authority_ref", "operation_id"], "properties": {"id": {"type": "string"}, "schema_version": {"const": 1}, "relationship": {"enum": ["refresh", "correction", "supersession", "composition", "derivation", "identity_fork", "retraction"]}, "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "target": {"type": "string"}, "authority_ref": {"type": "string"}, "operation_id": {"type": "string"}}},
    "reliance": {"type": "object", "additionalProperties": false, "required": ["id", "schema_version", "consumer", "consumer_revision", "decision_scope", "claim_revision_id", "state", "predecessor_reliance", "authority_ref", "operation_id"], "properties": {"id": {"type": "string"}, "schema_version": {"const": 1}, "consumer": {"type": "string"}, "consumer_revision": {"type": "string"}, "decision_scope": {"type": "string"}, "claim_revision_id": {"type": "string"}, "state": {"enum": ["active", "retired", "superseded"]}, "predecessor_reliance": {"type": ["string", "null"]}, "authority_ref": {"type": "string"}, "operation_id": {"type": "string"}}},
    "operation_receipt": {"type": "object", "additionalProperties": false, "required": ["operation_id", "action", "payload_sha256", "result_identity", "authority_ref"], "properties": {"operation_id": {"type": "string"}, "action": {"type": "string"}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "result_identity": {"type": "string"}, "authority_ref": {"type": "string"}}},
    "projection_boundary": {"type": "object", "additionalProperties": false, "required": ["actual_content_set", "source_watermark", "excluded_inputs", "failed_inputs", "freshness", "completeness"], "properties": {"actual_content_set": {"type": "string"}, "source_watermark": {"type": ["string", "null"]}, "excluded_inputs": {"type": "array", "items": {"type": "string"}}, "failed_inputs": {"type": "array", "items": {"type": "string"}}, "freshness": {"type": "string"}, "completeness": {"enum": ["available", "partial", "unavailable"]}}}
  }
}
