{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-engine.local/schemas/proposal-decision-v2.schema.json",
  "title": "Work Engine proposal decision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "source",
    "decision",
    "authority",
    "constraints",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/supersession"
        }
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_revision",
        "lifecycle_state",
        "placement_state"
      ],
      "properties": {
        "repository_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lifecycle_state": {
          "enum": [
            "formed",
            "placement_uncertain",
            "evaluated",
            "decided"
          ]
        },
        "placement_state": {
          "enum": [
            "uncertain",
            "probable",
            "confirmed",
            "rejected"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "lifecycle_state",
        "placement_state",
        "placement_claim",
        "rationale",
        "reopening_conditions"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "defer_for_dogfooding",
            "approve_proposal_meaning",
            "revise_placement"
          ]
        },
        "lifecycle_state": {
          "const": "decided"
        },
        "placement_state": {
          "enum": [
            "uncertain",
            "probable"
          ]
        },
        "placement_claim": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reopening_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_owner",
        "exercised_by",
        "evidence"
      ],
      "properties": {
        "decision_owner": {
          "type": "string",
          "minLength": 1
        },
        "exercised_by": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permanent_architecture_settled",
        "roadmap_priority_changed",
        "implementation_authorized"
      ],
      "properties": {
        "permanent_architecture_settled": {
          "const": false
        },
        "roadmap_priority_changed": {
          "const": false
        },
        "implementation_authorized": {
          "const": false
        }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^decision-history/[A-Za-z0-9._-]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
