#!/usr/bin/env python3
"""Fake `codex exec` with the behaviour measured on 0.164.0.

`exec --json [opts] PROMPT` and `exec --json [opts] resume ID MSG` print
thread.started first, record the turn in $CODEX_HOME/thread_history_1.sqlite
(inProgress while running, completed after), and run the scripted successor
with CODEX_THREAD_ID set. FAKE_CODEX_MISMATCH=1 makes resume start another id.
"""
import json, os, sqlite3, subprocess, sys, tempfile, time, uuid
from pathlib import Path

HOME = Path(os.environ["CODEX_HOME"])
HERE = Path(__file__).resolve().parent


def db():
    con = sqlite3.connect(HOME / "thread_history_1.sqlite")
    con.execute("create table if not exists thread_turns (thread_id text, turn_id text, "
                "rollout_ordinal integer, status text)")
    return con


def main(argv):
    if argv[:1] != ["exec"]:
        print(f"fake codex: unsupported {argv}", file=sys.stderr); return 2
    args = [a for a in argv[1:] if a != "--json"]
    while args and args[0].startswith("-") and args[0] != "resume":
        args = args[2:] if args[0] in ("-s", "-c", "-m", "--sandbox") else args[1:]
    if args[:1] == ["resume"]:
        tid, prompt = args[1], args[2]
        if os.environ.get("FAKE_CODEX_MISMATCH"):
            tid = str(uuid.uuid4())
    else:
        tid, prompt = str(uuid.uuid4()), args[0]
    print(json.dumps({"type": "thread.started", "thread_id": tid}), flush=True)
    con = db()
    n = con.execute("select count(*) from thread_turns where thread_id=?", (tid,)).fetchone()[0]
    con.execute("insert into thread_turns values (?,?,?,?)", (tid, str(uuid.uuid4()), n + 1, "inProgress"))
    con.commit()
    pf = Path(tempfile.mkstemp(prefix="fake-codex-prompt-")[1]); pf.write_text(prompt)
    env = dict(os.environ, CODEX_THREAD_ID=tid)
    env.pop("CLAUDE_CODE_SESSION_ID", None)
    if os.environ.get("FAKE_TURN") == "hang":
        time.sleep(600)
    subprocess.run([sys.executable, str(HERE / "fake_successor.py"), str(pf)], env=env)
    con.execute("update thread_turns set status='completed' where thread_id=? and rollout_ordinal=?", (tid, n + 1))
    con.commit()
    print(json.dumps({"type": "turn.completed"}), flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
