{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignments", "method_limitations"],
  "properties": {
    "assignments": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text_id", "reference_id", "confidence", "rationale"],
        "properties": {
          "text_id": {"type": "string"},
          "reference_id": {"type": "string"},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "method_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
