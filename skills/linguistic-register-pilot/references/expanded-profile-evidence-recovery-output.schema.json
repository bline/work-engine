{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_sha256", "features", "limitations"],
  "properties": {
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "features": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["feature_id", "decision", "evidence", "rationale"],
        "properties": {
          "feature_id": {"enum": ["lexicon-abstract-relational", "lexicon-diagnostic-deficit", "syntax-stacked-subordination", "rhythm-telegraphic-prompt-response"]},
          "decision": {"enum": ["retain", "drop"]},
          "evidence": {
            "type": "array", "maxItems": 6,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "excerpt_segment", "observation"],
              "properties": {
                "source_id": {"type": "string"},
                "excerpt_segment": {"enum": ["beginning", "middle", "end"]},
                "observation": {"type": "string", "minLength": 20}
              }
            }
          },
          "rationale": {"type": "string", "minLength": 20}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
