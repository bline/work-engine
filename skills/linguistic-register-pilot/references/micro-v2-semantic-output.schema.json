{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions", "method_limitations"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "verdict", "proposition_checks", "speech_act_equivalent", "added_meaning", "rationale"],
        "properties": {
          "sample_id": {"type": "string"},
          "verdict": {"enum": ["equivalent", "not_equivalent", "uncertain"]},
          "proposition_checks": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["proposition_id", "status", "evidence"],
              "properties": {
                "proposition_id": {"type": "string"},
                "status": {"enum": ["preserved", "omitted", "altered", "uncertain"]},
                "evidence": {"type": "string", "minLength": 1}
              }
            }
          },
          "speech_act_equivalent": {"type": "boolean"},
          "added_meaning": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "method_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
