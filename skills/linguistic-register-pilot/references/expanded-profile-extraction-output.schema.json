{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_sha256", "features", "limitations"],
  "properties": {
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "features": {
      "type": "array", "minItems": 8, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "layer", "category", "description", "distinctiveness_weight", "evidence", "cross_family"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "layer": {"enum": ["surface", "discourse"]},
          "category": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string", "minLength": 20},
          "distinctiveness_weight": {"type": "integer", "minimum": 1, "maximum": 5},
          "evidence": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "excerpt_segment", "observation"],
              "properties": {
                "source_id": {"type": "string"},
                "excerpt_segment": {"enum": ["beginning", "middle", "end"]},
                "observation": {"type": "string", "minLength": 12}
              }
            }
          },
          "cross_family": {"type": "boolean"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
