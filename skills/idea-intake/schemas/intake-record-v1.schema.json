{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-engine.local/schemas/intake-record-v1.schema.json",
  "title": "Work Engine idea intake record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea_id", "assessment_id", "source", "assessment", "narrative", "evidence", "relationships", "claims", "proposal_refs", "non_authorization"],
  "properties": {
    "schema_version": {"const": 1},
    "idea_id": {"type": "string", "pattern": "^work-engine\\.idea\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "assessment_id": {"type": "string", "pattern": "^work-engine\\.intake\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source": {"$ref": "#/$defs/source"},
    "assessment": {"$ref": "#/$defs/assessment"},
    "narrative": {"$ref": "#/$defs/path_reference"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "proposal_refs": {"type": "array", "items": {"$ref": "#/$defs/proposal_reference"}},
    "non_authorization": {"$ref": "#/$defs/non_authorization"}
  },
  "$defs": {
    "source_range": {
      "type": "object", "additionalProperties": false,
      "required": ["line_start", "line_end", "content_sha256"],
      "properties": {
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_revision", "blob_oid", "path", "range"],
      "properties": {
        "repository_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "blob_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "path": {"type": "string", "minLength": 1},
        "range": {"$ref": "#/$defs/source_range"}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "scope", "evidence_refs"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_cutoff": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_revision", "description"],
      "properties": {
        "repository_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "producer", "authority", "purpose", "evidence_cutoff", "published_state", "reopening_conditions"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "producer": {"$ref": "#/$defs/actor"},
        "authority": {"$ref": "#/$defs/authority"},
        "purpose": {"type": "string", "minLength": 1},
        "evidence_cutoff": {"$ref": "#/$defs/evidence_cutoff"},
        "published_state": {"enum": ["unresolved", "ready_for_handoff", "no_proposal", "superseded", "withdrawn"]},
        "reopening_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "path_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "kind", "owner", "reference", "revision", "attribution", "verification"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^evidence\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "kind": {"enum": ["prior_reconciliation", "repository_observation", "proposal", "implementation", "human_decision", "contract", "external"]},
        "owner": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "verification": {"$ref": "#/$defs/evidence_verification"}
      }
    },
    "evidence_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "integrity_sha256", "freshness_rule"],
      "properties": {
        "mode": {"enum": ["repository_file", "git_object", "external_attestation"]},
        "integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "freshness_rule": {"type": "string", "minLength": 1}
      }
    },
    "relationship_target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "reference"],
      "properties": {
        "kind": {"enum": ["claim", "idea", "intake", "proposal", "implementation", "contract"]},
        "id": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_id", "type", "source_claim_id", "target", "status", "evidence_refs", "authority_ref", "rationale"],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^relationship\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "type": {"enum": ["possibly_duplicates", "possibly_refines", "possibly_conflicts_with", "apparently_represented_by_proposal", "apparently_implemented_by", "contains_independent_candidate"]},
        "source_claim_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/relationship_target"},
        "status": {"enum": ["nominated", "adjudicated"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authority_ref": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["meaning", "boundary", "placement_hypotheses", "evidence_still_needed", "unresolved_decisions", "next_consumer"],
      "properties": {
        "meaning": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "placement_hypotheses": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_still_needed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unresolved_decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_consumer": {"const": "proposal-former"}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "revision", "source_range", "statement", "statement_kind", "disposition", "uncertainty", "evidence_refs", "relationship_refs", "candidate"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^claim\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "revision": {"type": "integer", "minimum": 1},
        "source_range": {"$ref": "#/$defs/source_range"},
        "statement": {"type": "string", "minLength": 1},
        "statement_kind": {"enum": ["source_assertion", "assessor_interpretation", "open_question"]},
        "disposition": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "status", "rationale", "authority_ref"],
          "properties": {
            "state": {"enum": ["represented_by_proposal", "apparently_implemented", "still_novel", "unresolved", "ready_for_proposal_formation", "unsuitable_for_proposal"]},
            "status": {"enum": ["nominated", "adjudicated"]},
            "rationale": {"type": "string", "minLength": 1},
            "authority_ref": {"type": ["string", "null"]}
          }
        },
        "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "relationship_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "candidate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate"}]}
      }
    },
    "proposal_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "path", "revision"],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^work-engine\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "path": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "non_authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["cleanup_authorized", "implementation_authorized", "proposal_accepted", "permanent_placement_settled", "roadmap_priority_changed"],
      "properties": {
        "cleanup_authorized": {"const": false},
        "implementation_authorized": {"const": false},
        "proposal_accepted": {"const": false},
        "permanent_placement_settled": {"const": false},
        "roadmap_priority_changed": {"const": false}
      }
    }
  }
}
