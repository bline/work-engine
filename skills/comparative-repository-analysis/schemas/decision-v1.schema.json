{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Wire shape only. comparison_artifacts.py is the authoritative semantic validator.",
  "title": "Comparison decision v1",
  "type": "object",
  "required": [
    "artifact_type",
    "compatibility",
    "classification",
    "target_work_engine_boundary",
    "profile_claim_refs",
    "profile_claim_states",
    "profile_sha256",
    "assumptions",
    "invalidation_triggers",
    "unresolved_questions"
  ],
  "properties": {
    "artifact_type": {
      "const": "comparison_decision_v1"
    },
    "classification": {
      "enum": [
        "KEEP",
        "ADOPT",
        "BORROW",
        "AVOID",
        "INVESTIGATE"
      ]
    },
    "profile_claim_states": {
      "type": "object",
      "additionalProperties": {
        "enum": ["supported", "disputed", "unresolved", "superseded"]
      }
    },
    "profile_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": true
}
