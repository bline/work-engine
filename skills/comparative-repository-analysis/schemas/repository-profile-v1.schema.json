{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Wire shape only. comparison_artifacts.py is the authoritative semantic validator.",
  "title": "Repository profile v1",
  "description": "Descriptive artifact; adoption decisions are forbidden by the semantic validator.",
  "type": "object",
  "required": [
    "artifact_type",
    "compatibility",
    "repository_id",
    "dimension_states",
    "capabilities",
    "claims",
    "evidence",
    "reconciliation",
    "unknowns",
    "provenance"
  ],
  "properties": {
    "artifact_type": {
      "const": "repository_profile_v1"
    },
    "provenance": {
      "type": "object",
      "required": ["dimension_passes", "index_receipt", "index_receipt_sha256"],
      "properties": {
        "dimension_passes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dimension", "sha256", "provenance"],
            "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
