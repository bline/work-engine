{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-engine.experimental.claim-lineage-dogfood.v1",
  "title": "Bounded claim-lineage dogfood records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "authority_grants", "claims", "revisions", "events", "nominations", "episodes", "judgments", "reliances", "edges", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "run": {"$ref": "#/$defs/run"},
    "authority_grants": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "revisions": {"type": "array", "items": {"$ref": "#/$defs/revision"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "nominations": {"type": "array", "items": {"$ref": "#/$defs/nomination"}},
    "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}},
    "judgments": {"type": "array", "items": {"$ref": "#/$defs/judgment"}},
    "reliances": {"type": "array", "items": {"$ref": "#/$defs/reliance"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "base": {"type": "object", "required": ["id", "type", "schema_version"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string"}, "schema_version": {"const": 1}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["id", "selection_cutoff", "selection_tree", "selection_classification", "fixture_plan", "canonical_owner", "projection_owner"], "properties": {"id": {"type": "string"}, "selection_cutoff": {"type": "string"}, "selection_tree": {"type": "string"}, "selection_classification": {"const": "purposive_historical_known_outcomes"}, "fixture_plan": {"type": "string"}, "canonical_owner": {"type": "string"}, "projection_owner": {"const": "none_generated_only"}}},
    "authority": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "act", "actor", "scope", "evidence", "limitations"], "properties": {"id": {"type": "string"}, "type": {"const": "authority_grant"}, "schema_version": {"const": 1}, "act": {"type": "string"}, "actor": {"type": "string"}, "scope": {"type": "string"}, "evidence": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}}]},
    "claim": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "namespace", "kind", "subject", "question", "quantification", "authority_domain"], "properties": {"id": {"type": "string"}, "type": {"const": "claim"}, "schema_version": {"const": 1}, "namespace": {"type": "string"}, "kind": {"type": "string"}, "subject": {"type": "string"}, "question": {"type": "string"}, "quantification": {"type": "string"}, "authority_domain": {"type": "string"}}}]},
    "revision": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "claim_id", "ordinal", "conclusion", "outcome", "evidence_baseline", "producer", "authority_ref", "limitations"], "properties": {"id": {"type": "string"}, "type": {"const": "claim_revision"}, "schema_version": {"const": 1}, "claim_id": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 1}, "conclusion": {"type": "string"}, "outcome": {"enum": ["original", "retained_unchanged", "changed", "counterfixture"]}, "evidence_baseline": {"type": "object"}, "producer": {"type": "string"}, "authority_ref": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}}]},
    "event": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "event_kind", "repository_revision", "tree", "evidence"], "properties": {"id": {"type": "string"}, "type": {"const": "source_event"}, "schema_version": {"const": 1}, "event_kind": {"type": "string"}, "repository_revision": {"type": "string"}, "tree": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}}}]},
    "nomination": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "source_event_id", "target_revision_id", "producer", "disposition", "rationale"], "properties": {"id": {"type": "string"}, "type": {"const": "impact_nomination"}, "schema_version": {"const": 1}, "source_event_id": {"type": "string"}, "target_revision_id": {"type": "string"}, "producer": {"type": "string"}, "disposition": {"enum": ["resolved_unchanged", "resolved_changed"]}, "rationale": {"type": "string"}}}]},
    "episode": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "subject_revision_id", "trigger_nomination_id", "owner", "authority_ref", "evidence_cutoff", "terminal_state"], "properties": {"id": {"type": "string"}, "type": {"const": "refresh_episode"}, "schema_version": {"const": 1}, "subject_revision_id": {"type": "string"}, "trigger_nomination_id": {"type": "string"}, "owner": {"type": "string"}, "authority_ref": {"type": "string"}, "evidence_cutoff": {"type": "string"}, "terminal_state": {"enum": ["retained_unchanged", "changed"]}}}]},
    "judgment": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "episode_id", "outcome", "producer", "authority_ref", "result_revision_id", "causal_event_ids", "basis"], "properties": {"id": {"type": "string"}, "type": {"const": "refresh_judgment"}, "schema_version": {"const": 1}, "episode_id": {"type": "string"}, "outcome": {"enum": ["retained_unchanged", "changed"]}, "producer": {"type": "string"}, "authority_ref": {"type": "string"}, "result_revision_id": {"type": "string"}, "causal_event_ids": {"type": "array", "items": {"type": "string"}}, "basis": {"type": "array", "items": {"type": "string"}}}}]},
    "reliance": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "consumer", "consumer_revision", "decision_scope", "claim_revision_id", "state", "authority_ref", "reopening_owner", "historicity"], "properties": {"id": {"type": "string"}, "type": {"const": "reliance"}, "schema_version": {"const": 1}, "consumer": {"type": "string"}, "consumer_revision": {"type": "string"}, "decision_scope": {"type": "string"}, "claim_revision_id": {"type": "string"}, "state": {"const": "active"}, "authority_ref": {"type": "string"}, "reopening_owner": {"const": "user"}, "historicity": {"const": "prospective_dogfood_reliance"}}}]},
    "edge": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "relationship", "source", "source_type", "target", "target_type", "producer", "authority_ref"], "properties": {"id": {"type": "string"}, "type": {"const": "lineage_edge"}, "schema_version": {"const": 1}, "relationship": {"enum": ["refreshes", "may_affect", "sourced_by", "reopened_by", "produces", "changed_because_of", "relies_on", "contrasts_with"]}, "source": {"type": "string"}, "source_type": {"type": "string"}, "target": {"type": "string"}, "target_type": {"type": "string"}, "producer": {"type": "string"}, "authority_ref": {"type": "string"}}}]}
  }
}
