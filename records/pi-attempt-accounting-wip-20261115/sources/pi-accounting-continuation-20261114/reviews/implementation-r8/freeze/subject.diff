+      ],
+      "type": "object"
+    }
+  },
+  "$id": "urn:pi-accounting:evidence:1.7-s1",
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "oneOf": [
+    {
+      "$ref": "#/$defs/AccountingInputProof"
+    },
+    {
+      "$ref": "#/$defs/AccountingResult"
+    },
+    {
+      "$ref": "#/$defs/AccountingExpectedAssertion"
+    }
+  ]
+}
