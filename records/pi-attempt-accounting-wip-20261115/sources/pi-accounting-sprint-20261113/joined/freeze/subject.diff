+    fn each_canonical_node_revision_invalidates_generated_identity() {
+        let s = fixture();
+        let i = interface(&s);
+        let original = generated(&s, &i).unwrap();
+        let mut count = 0;
+        for field in [
+            "types",
+            "stages",
+            "rules",
+            "formulas",
+            "invariants",
+            "owner_policies",
+        ] {
+            let raw = json(&s);
+            for index in 0..raw[field].as_array().unwrap().len() {
+                let mut changed = raw.clone();
