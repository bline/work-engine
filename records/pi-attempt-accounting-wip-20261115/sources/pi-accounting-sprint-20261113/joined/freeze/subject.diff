+{
+  "contract_version": "pi-accounting-contract/1.5-s1",
+  "formulas": [
+    {
+      "depends": [],
+      "id": "PRICE-OPENAI",
+      "inputs": [
+        "input",
+        "cached",
+        "write",
+        "output",
+        "r_in",
+        "r_cached",
+        "r_write",
+        "r_out",
+        "tier"
+      ],
+      "refs": [
+        "POLICY-R6",
+        "SOURCE-IDENTITIES"
+      ],
+      "revision": 1,
+      "text": "((input-cached-write)*r_in + cached*r_cached + write*r_write + output*r_out)*tier; input>272000: input-side rates*2 and output rate*1.5; checked integer nano arithmetic."
+    },
+    {
+      "depends": [],
+      "id": "PRICE-ANTHROPIC",
+      "inputs": [
+        "input",
+        "cache_read",
+        "w5m",
+        "w1h",
+        "cache_write",
+        "output",
+        "r_in",
+        "r_read",
+        "r_5m",
+        "r_1h",
+        "r_out"
+      ],
+      "refs": [
+        "POLICY-R6",
+        "SOURCE-IDENTITIES"
+      ],
+      "revision": 1,
+      "text": "input*r_in + cache_read*r_read + w5m*r_5m + w1h*r_1h + (cache_write-w5m-w1h)*residual(r_5m,r_1h) + output*r_out; residual=min for low, max for high and producer consistency."
+    },
+    {
+      "depends": [],
+      "id": "RESERVATION-MAX",
+      "inputs": [
+        "C.reservations"
+      ],
+      "refs": [
+        "POLICY-R6"
+      ],
+      "revision": 1,
+      "text": "R = max({distinct well-formed reservation amounts} union {0}); never sum/min; malformed amounts contribute 0 and blocking MalformedEvidence(reserved)."
+    },
+    {
+      "depends": [],
+      "id": "ERROR-EXPOSURE",
+      "inputs": [
+        "C.reservations",
+        "S.decision",
+        "V.valuation"
+      ],
+      "refs": [
+        "POLICY-R6"
+      ],
+      "revision": 1,
+      "text": "low = valued.low or supported_low or 0; high = AtLeast(max(R, valued.high or priced_high or 0)); valid ErrorStatus closes time and retains ReservationBound."
+    },
+    {
+      "depends": [],
+      "id": "ELIGIBLE-EXPOSURE",
+      "inputs": [
+        "S.decision",
+        "V.valuation",
+        "F.replacement"
+      ],
+      "refs": [
+        "POLICY-R6"
+      ],
+      "revision": 1,
+      "text": "low = valuation.low; high = Exact(max(charged,valuation.high)); finite only with complete usage over established fully priced identity and tier sets."
+    },
+    {
+      "depends": [],
+      "id": "INELIGIBLE-EXPOSURE",
+      "inputs": [
+        "C.reservations",
+        "S.decision",
+        "V.valuation",
+        "F.replacement"
+      ],
+      "refs": [
+        "POLICY-R6"
+      ],
+      "revision": 1,
+      "text": "low and known components follow X-TABLE; high = AtLeast(max(R, applicable well-formed claimed charges, usage high or priced_high or 0)); no financial decision reads K."
+    },
+    {
+      "depends": [],
+      "id": "TOLERANCE",
+      "inputs": [
+        "producer_price",
+        "charged"
+      ],
+      "refs": [
+        "POLICY-R6",
+        "SOURCE-IDENTITIES"
+      ],
+      "revision": 1,
+      "text": "T_round=501 nano; producer_price<10^15 and charged>=producer_price-501; otherwise ToleranceRange or Undercharge."
+    },
+    {
+      "depends": [],
+      "id": "BASIS-TIE",
+      "inputs": [
+        "components"
+      ],
+      "refs": [
+        "POLICY-R6"
+      ],
+      "revision": 1,
+      "text": "max takes basis of largest; ties prefer UsageValuation, then ProxyReservation, then ProxyCharge. Nonzero supported low has usage basis."
+    },
+    {
+      "depends": [],
+      "id": "COMMITMENT-RESIDUAL",
+      "inputs": [
+        "B",
+        "owned_high"
+      ],
+      "refs": [
+        "POLICY-R6"
+      ],
+      "revision": 1,
+      "text": "max(0,B-known session owned high) is separate allocation arithmetic conditional on qualified trusted whole-session USD bound; never changes C-K amounts; AtLeast owned aggregate remains unresolved even with finite residual; P>B alone is not contradictory bill evidence."
+    }
+  ],
