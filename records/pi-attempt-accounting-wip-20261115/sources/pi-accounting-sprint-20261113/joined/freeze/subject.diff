l derivation, fixture approval, production verifier or S2a readiness.\",\n  \"obligation\": {\n    \"closed\": {\n      \"amount_source\": [\n        \"settlement_amount\",\n        \"reservation_confirmed\",\n        \"reservation_bound\"\n      ],\n      \"by\": \"EvidenceRef\",\n      \"state\": \"closed\"\n    },\n    \"none\": {\n      \"amount_source\": \"none\",\n      \"cause\": [\n        \"unbudgeted\",\n        \"no_reservation\",\n        \"orphan\",\n        \"subscription\"\n      ],\n      \"state\": \"none\"\n    },\n    \"outstanding\": {\n      \"amount_source\": \"reservation_bound\",\n      \"state\": \"outstanding\"\n    }\n  },\n  \"replacement\": {\n    \"eligible\": \"bool\",\n    \"reason\": [\n      \"UsageBound\",\n      \"NotUsageSettlement\",\n      \"UsageIncomplete\",\n      \"UsageUnpriceable\",\n      \"NoReservation\"\n    ]\n  },\n  \"revision\": 6,\n  \"schema\": \"pi-accounting-interface/1\",\n  \"settlement\": {\n    \"basis\": [\n      \"usage\",\n      \"reservation\",\n      \"upstream_error\",\n      \"error_status\"\n    ],\n    \"decision\": [\n      \"absent\",\n      \"valid\",\n      \"rejected\",\n      \"conflicting\",\n      \"not_applicable\"\n    ],\n    \"reasons\": [\n      \"ReservationConflict\",\n      \"NoReservation\",\n      \"Order\",\n      \"AttemptNumber\",\n      \"AmountType\",\n      \"ReservedMismatch\",\n      \"BasisMissing\",\n      \"BasisUnknown\",\n      \"KeepAll\",\n      \"StatusType\",\n      \"ErrorCharge\",\n      \"UsageUnpriceable\",\n      \"ModelMismatch\",\n      \"ToleranceRange\",\n      \"Undercharge\"\n    ]\n  },\n  \"trusted_fixture_inputs\": {\n    \"placement\": \"top-level sibling of inputs; never inside producer log rows\",\n    \"schema\": {\n      \"gate_verifications\": {\n        \"<gate_id>\": {\n          \"authority_id\": \"string\",\n          \"payload_sha256\": \"64 lowercase hex\",\n          \"policy_ref\": \"string\",\n          \"session\": \"string\",\n     