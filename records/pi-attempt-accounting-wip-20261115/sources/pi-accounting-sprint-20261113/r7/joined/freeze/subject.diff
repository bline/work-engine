+pub(crate) fn named_type(ty: &str, s: &Spec) -> Option<String> {
+    let mut t = ty;
+    while let Some(inner) = t
+        .strip_prefix("List<")
+        .or_else(|| t.strip_prefix("Option<"))
+    {
+        t = inner.strip_suffix('>')?;
+    }
+    s.types.iter().any(|x| x.id == t).then(|| t.to_string())
