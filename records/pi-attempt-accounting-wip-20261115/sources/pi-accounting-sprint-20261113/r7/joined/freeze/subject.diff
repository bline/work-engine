+                "none"
+            } else if temporal == "outstanding" || witness == "other" {
+                "reservation_bound"
+            } else if witness == "eligible_usage" {
+                "settlement_amount"
+            } else {
+                "reservation_confirmed"
+            };
+            let preserve: Vec<String> = if temporal == "none" {
+                vec!["cause".into()]
+            } else if temporal == "closed" {
+                vec!["by".into()]
