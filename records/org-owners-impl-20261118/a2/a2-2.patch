+        Terms {
+            requirements_digest: other.requirements_digest,
+            ..base.clone()
+        },
+        Terms {
+            scope: ProblemScopeRef::fixture("run-1", "plan-a", 2),
+            ..base.clone()
+        },
+    ];
+    for admitted in variants {
+        let w = world(Opts {
