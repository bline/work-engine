+    w.src.issue(Record::fixture_vantage_binding(
+        successor,
+        "vantage-builder",
+        w.builder,
+        RealizationDigest::new("real-builder"),
+        "uid:svc-builder",
+    ));
+    let readmitted = decide_base(&w).expect("admitted under the successor");
+    assert_eq!(
+        readmitted.organization(),
+        &AdmittedOrganization {
+            admission: successor,
