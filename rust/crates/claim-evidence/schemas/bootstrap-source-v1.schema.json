{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-engine.local/claim-evidence/bootstrap-source-v1.schema.json",
  "title": "Host-owned claim-evidence authority source v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "owner", "reference", "revision", "freshness", "profile", "actors", "decision_scopes", "grant_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "owner": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1}, "freshness": {"type": "string", "minLength": 1},
    "profile": {"const": "native-review-claims-v1"},
    "actors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
