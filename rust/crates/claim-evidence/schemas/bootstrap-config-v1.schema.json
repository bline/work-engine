{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-engine.local/claim-evidence/bootstrap-config-v1.schema.json",
  "title": "Private claim-evidence root bootstrap configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "root_id", "grants"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "native-review-claims-v1"},
    "root_id": {"type": "string", "minLength": 1},
    "grants": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/grant"}}
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "grant_id", "actor", "profile", "permissions", "decision_scope", "authority_reference"],
      "properties": {
        "schema_version": {"const": 1},
        "grant_id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "profile": {"const": "revision-bound-review-finding-v1"},
        "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["create_claim", "publish_revision", "record_reliance"]}},
        "decision_scope": {"type": "string", "minLength": 1},
        "authority_reference": {
          "type": "object", "additionalProperties": false,
          "required": ["owner", "reference", "revision", "integrity_sha256", "freshness", "status"],
          "properties": {
            "owner": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "integrity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "freshness": {"type": "string", "minLength": 1}, "status": {"const": "verified"}
          }
        }
      }
    }
  }
}
