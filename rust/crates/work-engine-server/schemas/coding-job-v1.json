{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-engine.coding-job.v1",
  "title": "Coding-job capability DTOs (strict; unknown fields rejected)",
  "x-capability": "coding-job-offline-fixture-v1",
  "x-qualification": "offline fixture only; not a live qualification and not offline-synthetic-v1",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "job_credential": { "type": "string", "minLength": 32, "maxLength": 256, "description": "Operator-provisioned for one caller and one job; its SHA-256 is pinned in the profile. Never a session-message grant or the service bearer." },
    "submit_coding_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "authorization_id", "job_credential", "job_sha256", "packet_sha256"],
      "properties": {
        "request_id": { "$ref": "#/$defs/request_id" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "job_credential": { "$ref": "#/$defs/job_credential" },
        "job_sha256": { "$ref": "#/$defs/sha256" },
        "packet_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "read_or_cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "authorization_id", "job_credential"],
      "properties": {
        "request_id": { "$ref": "#/$defs/request_id" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "job_credential": { "$ref": "#/$defs/job_credential" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["schema", "operation_id", "request_id", "authorization_id", "job_id", "state_dir", "job_sha256", "state", "entered_possible", "collector_live", "process_cleanup", "limitations", "settlement"],
      "properties": {
        "schema": { "const": "work-engine.coding-job.v1" },
        "state": { "enum": ["bound_not_entered", "collecting", "reconciling", "collected", "entry_uncertain", "host_state_unreadable"] },
        "host_input_digest": { "type": ["string", "null"], "description": "Host digest, observed after admission and pinned on first sight; the pre-execution binding is job_sha256." },
        "settlement": { "const": "not_established_by_submission" }
      }
    },
    "result": {
      "type": "object",
      "required": ["schema", "result", "operation"],
      "properties": {
        "result": { "enum": ["available", "not_available"] },
        "terminal": { "type": "object" },
        "validation": { "type": "object" },
        "cleanup": { "type": "object" },
        "acceptance": { "description": "Host value passed through; owner_pending is preserved." },
        "domain_effect_settlement": { "description": "Host value passed through; not_claimed is preserved." },
        "receipt": { "type": "object" }
      }
    },
    "cancel": {
      "type": "object",
      "required": ["schema", "operation_id", "cancellation", "cancellation_established", "container_closure_established", "settlement"],
      "properties": {
        "cancellation": { "enum": ["requested", "request_not_recorded"] },
        "cancellation_established": { "const": false },
        "container_closure_established": { "const": false },
        "settlement": { "const": "not_claimed" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "capability", "class", "host_binary", "host_binary_sha256", "operation_root", "collector_deadline_seconds", "cancel_grace_seconds", "authorizations"],
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "coding-job-profile" },
        "capability": { "const": "coding-job-offline-fixture-v1" },
        "class": { "const": "offline-fixture" },
        "host_binary": { "type": "string" },
        "host_binary_sha256": { "$ref": "#/$defs/sha256" },
        "operation_root": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "collector_deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
        "cancel_grace_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "authorizations": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authorization_id", "caller", "credential_sha256", "job_file", "job_sha256", "packet_sha256", "job_id", "state_dir"],
            "properties": {
              "authorization_id": { "$ref": "#/$defs/id" },
              "caller": { "$ref": "#/$defs/id" },
              "credential_sha256": { "$ref": "#/$defs/sha256" },
              "job_file": { "type": "string" },
              "job_sha256": { "$ref": "#/$defs/sha256" },
              "packet_sha256": { "$ref": "#/$defs/sha256" },
              "job_id": { "$ref": "#/$defs/id" },
              "state_dir": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
