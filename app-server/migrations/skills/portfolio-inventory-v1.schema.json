{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-engine.skills-migration.portfolio-inventory-v1",
  "title": "Work Engine skills migration portfolio inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "evidence_only_notice", "classification_state", "authority_status", "baseline", "graph_limitations", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_id": {"type": "string", "minLength": 1},
    "evidence_only_notice": {"type": "string", "minLength": 1},
    "classification_state": {"const": "provisional"},
    "authority_status": {"const": "not_accepted"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_head", "worktree_observation"],
      "properties": {
        "git_head": {"type": "string", "minLength": 1},
        "worktree_observation": {"type": "string", "minLength": 1}
      }
    },
    "graph_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "packages": {
      "type": "array",
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "protected_distinction", "candidate_disposition"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "protected_distinction": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "^Preserve the observable consequence exercised by .+ while its owning boundary is classified\\.$"}
        },
        "candidate_disposition": {"enum": ["retain", "relocate", "rewrite", "compatibility", "historical", "remove"]}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "classification_state", "authority_status", "responsibility", "shapes", "candidate_destination", "compatibility_posture", "reviewer_applicability", "consumers", "server_service_dependencies", "unresolved_authority_questions", "evidence_sources", "source", "artifacts", "tests"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "classification_state": {"const": "provisional"},
        "authority_status": {"const": "not_accepted"},
        "responsibility": {"type": "string", "minLength": 1},
        "shapes": {"type": "array", "minItems": 1, "items": {"enum": ["agent_skill", "role_like", "deterministic_capability", "service_state", "provider_adapter", "experiment", "projection", "mixed"]}},
        "candidate_destination": {"type": "string", "minLength": 1},
        "compatibility_posture": {"type": "string", "minLength": 1},
        "reviewer_applicability": {"type": "string", "minLength": 1},
        "consumers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "server_service_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unresolved_authority_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source": {"$ref": "#/$defs/evidence"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "tests": {"type": "array", "items": {"$ref": "#/$defs/testEvidence"}}
      }
    }
  }
}
